#!/usr/bin/env grease
# ROOT ANDROID_NDK_CHECKOUT LIBRARY ABI OUTPUT; SDK/signing inputs are explicit environment values.
var root = $(git -C "$[ARGV[0]]" rev-parse --show-toplevel)
var substrate = ARGV[1]
var library = ARGV[2]
var abi = ARGV[3]
var output = ARGV[4]
test -f "$substrate/apk/build-nativeactivity-apk.sh"
export ANDROID_PACKAGE_ID=org.isomorphisms.mostow
export ANDROID_VERSION_CODE=1
export ANDROID_VERSION_NAME=0.1
export ANDROID_MIN_SDK=21
export ANDROID_TARGET_SDK=34
export ANDROID_KEYSTORE_TYPE=PKCS12
export ANDROID_KEY_ALIAS=wegert-debug
export ANDROID_STORE_PASSWORD=wegert-debug
export ANDROID_KEY_PASSWORD=wegert-debug
export ANDROID_EXPECTED_CERT_SHA256=de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9
export ANDROID_REQUIRE_NO_DEX=1
# Do not create a key or change the certificate to work around a failed check.
bash "$substrate/apk/build-nativeactivity-apk.sh" "$root/android/AndroidManifest.xml" "$library" "$abi" "$output"
